{
  "id": "mssmhs",
  "name": "中国中学生心理健康量表（MSSMHS / MMHI-60）",
  "origin": "中国科学院心理研究所王极盛教授编制（1997），症状取向自评量表，贴合中国中学生文化特性",
  "version": "1.0",
  "audience": ["junior", "senior"],
  "response_type": "likert5",
  "options": [
    {"value": 1, "label": "无"},
    {"value": 2, "label": "轻度"},
    {"value": 3, "label": "中度"},
    {"value": 4, "label": "偏重"},
    {"value": 5, "label": "严重"}
  ],
  "instruction": "下面是有关你近一个月来心理状态的一些问题，请你仔细阅读每一道题目，然后根据自己的实际情况认真回答。每个题目没有对错之分，请你尽快回答，不要在每道题目上过多思索。每个题目后有五个等级供你选择：1=无（自觉无该项问题）、2=轻度（偶有出现）、3=中度（时有出现）、4=偏重（经常出现）、5=严重（频繁且严重）。每个题目只能选择一个等级，不要遗漏。",
  "items": [
    {"id": 1, "text": "做作业必须反复检查。", "subscale": "ocd"},
    {"id": 2, "text": "为保证正确，做事必须做得很慢。", "subscale": "ocd"},
    {"id": 3, "text": "总担心自己的衣服是否整齐。", "subscale": "ocd"},
    {"id": 4, "text": "总在想一些不必要的事情。", "subscale": "ocd"},
    {"id": 5, "text": "必须反复洗手或反复数数。", "subscale": "ocd"},
    {"id": 6, "text": "明知担心没有用，但总害怕考不好。", "subscale": "ocd"},
    {"id": 7, "text": "我的想法总与别人不一样。", "subscale": "paranoid"},
    {"id": 8, "text": "觉得别人想占我的便宜。", "subscale": "paranoid"},
    {"id": 9, "text": "总感到有人在背后谈论我。", "subscale": "paranoid"},
    {"id": 10, "text": "我觉得对大多数人都不可信任。", "subscale": "paranoid"},
    {"id": 11, "text": "别人对我的表现评价不恰当。", "subscale": "paranoid"},
    {"id": 12, "text": "总觉得别人在跟我作对。", "subscale": "paranoid"},
    {"id": 13, "text": "我常发脾气，想控制但控制不住。", "subscale": "hostility"},
    {"id": 14, "text": "大叫或摔东西。", "subscale": "hostility"},
    {"id": 15, "text": "时常与人争论、抬杠。", "subscale": "hostility"},
    {"id": 16, "text": "我容易激动和烦恼。", "subscale": "hostility"},
    {"id": 17, "text": "有想伤害他人或打人的冲动。", "subscale": "hostility"},
    {"id": 18, "text": "有想摔东西的冲动。", "subscale": "hostility"},
    {"id": 19, "text": "感到人们对我不友好，不喜欢我。", "subscale": "interpersonal"},
    {"id": 20, "text": "当别人看着我或谈论我时，感到不自在。", "subscale": "interpersonal"},
    {"id": 21, "text": "感到别人不理解我，不同情我。", "subscale": "interpersonal"},
    {"id": 22, "text": "我感情容易受到别人的伤害。", "subscale": "interpersonal"},
    {"id": 23, "text": "同异性在一起时，感到害羞不自在。", "subscale": "interpersonal"},
    {"id": 24, "text": "要求别人十全十美。", "subscale": "interpersonal"},
    {"id": 25, "text": "我感到苦闷。", "subscale": "depression"},
    {"id": 26, "text": "容易哭泣。", "subscale": "depression"},
    {"id": 27, "text": "我感到前途没有希望。", "subscale": "depression"},
    {"id": 28, "text": "经常责怪自己。", "subscale": "depression"},
    {"id": 29, "text": "我常常无精打采，提不起劲来。", "subscale": "depression"},
    {"id": 30, "text": "经常有自杀的念头。", "subscale": "depression"},
    {"id": 31, "text": "我感到紧张或容易紧张。", "subscale": "anxiety"},
    {"id": 32, "text": "我感到坐立不安，心神不定。", "subscale": "anxiety"},
    {"id": 33, "text": "我无缘无故地突然感到害怕。", "subscale": "anxiety"},
    {"id": 34, "text": "感到心里烦躁。", "subscale": "anxiety"},
    {"id": 35, "text": "觉得心里不踏实。", "subscale": "anxiety"},
    {"id": 36, "text": "心里总觉得有事。", "subscale": "anxiety"},
    {"id": 37, "text": "我感到学习负担很重。", "subscale": "study_pressure"},
    {"id": 38, "text": "上课时，总担心老师会提问自己。", "subscale": "study_pressure"},
    {"id": 39, "text": "一听说要考试，心里就感到紧张。", "subscale": "study_pressure"},
    {"id": 40, "text": "我讨厌做作业。", "subscale": "study_pressure"},
    {"id": 41, "text": "我讨厌上学。", "subscale": "study_pressure"},
    {"id": 42, "text": "我讨厌考试。", "subscale": "study_pressure"},
    {"id": 43, "text": "我不喜欢参加学校的课外活动。", "subscale": "maladaptation"},
    {"id": 44, "text": "我对现在的学校生活感到不适应。", "subscale": "maladaptation"},
    {"id": 45, "text": "我看不惯现在的社会风气。", "subscale": "maladaptation"},
    {"id": 46, "text": "我不适应老师的教学方法。", "subscale": "maladaptation"},
    {"id": 47, "text": "家里环境干扰我的学习。", "subscale": "maladaptation"},
    {"id": 48, "text": "我不喜欢班里的风气。", "subscale": "maladaptation"},
    {"id": 49, "text": "我心情时好时坏。", "subscale": "emotional_instability"},
    {"id": 50, "text": "我学习劲头时高时低。", "subscale": "emotional_instability"},
    {"id": 51, "text": "我对做作业的热情忽高忽低。", "subscale": "emotional_instability"},
    {"id": 52, "text": "我对同学忽冷忽热。", "subscale": "emotional_instability"},
    {"id": 53, "text": "我对老师时而亲近，时而疏远。", "subscale": "emotional_instability"},
    {"id": 54, "text": "我对父母时而亲热，时而冷淡。", "subscale": "emotional_instability"},
    {"id": 55, "text": "同学考试成绩比我高，我感到难过。", "subscale": "imbalance"},
    {"id": 56, "text": "老师对我不公平。", "subscale": "imbalance"},
    {"id": 57, "text": "别的同学穿戴比我好，有钱，我感到不舒服。", "subscale": "imbalance"},
    {"id": 58, "text": "父母对我不公平。", "subscale": "imbalance"},
    {"id": 59, "text": "我对比我强的同学并不服气。", "subscale": "imbalance"},
    {"id": 60, "text": "同学考试成绩比我高，但能力并不比我强。", "subscale": "imbalance"}
  ],
  "subscales": [
    {"key": "ocd", "name": "强迫症状", "item_ids": [1,2,3,4,5,6]},
    {"key": "paranoid", "name": "偏执", "item_ids": [7,8,9,10,11,12]},
    {"key": "hostility", "name": "敌对", "item_ids": [13,14,15,16,17,18]},
    {"key": "interpersonal", "name": "人际关系敏感", "item_ids": [19,20,21,22,23,24]},
    {"key": "depression", "name": "抑郁", "item_ids": [25,26,27,28,29,30]},
    {"key": "anxiety", "name": "焦虑", "item_ids": [31,32,33,34,35,36]},
    {"key": "study_pressure", "name": "学习压力感", "item_ids": [37,38,39,40,41,42]},
    {"key": "maladaptation", "name": "适应不良", "item_ids": [43,44,45,46,47,48]},
    {"key": "emotional_instability", "name": "情绪不稳定", "item_ids": [49,50,51,52,53,54]},
    {"key": "imbalance", "name": "心理不平衡", "item_ids": [55,56,57,58,59,60]}
  ],
  "scoring": {
    "method": "因子分 = 因子内题目总分 / 因子题目数（1.0–5.0）；总均分 = 全部题目总分 / 60",
    "bands": [
      {"max": 1.99, "level": "normal", "label": "该维度自觉无明显问题"},
      {"max": 2.99, "level": "mild", "label": "存在轻度问题"},
      {"level": "moderate_plus", "label": "存在中度及以上问题，需关注"}
    ],
    "note": "常用判级：因子分≥2 提示存在问题，≥3 提示存在中度以上问题；总均分≥2 提示整体存在心理健康问题倾向"
  },
  "risk_rules": [
    {"id": "mssmhs-critical-suicidal-ideation", "severity": "critical", "condition": {"any_items_gte": [{"item": 30, "value": 3}]}, "message": "第30题（自杀念头）≥中度，需立即启动危机干预流程"},
    {"id": "mssmhs-high-depression", "severity": "high", "condition": {"subscale_mean_gte": [{"subscale": "depression", "value": 3.5}]}, "message": "抑郁因子分≥3.5，需重点关怀与跟进"},
    {"id": "mssmhs-multi-dim-distress", "severity": "high", "condition": {"subscales_mean_gte_3_count": 3}, "message": "≥3 个维度因子分达到中度以上，整体困扰面广"}
  ],
  "sources": ["https://scale.xinlixue.cn/archives/MSSMHS.html", "https://www.wjx.cn/vm/PpnHTYz.aspx"]
}
