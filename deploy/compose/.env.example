# Compassio docker-compose 环境变量示例（复制为 .env 后修改）
POSTGRES_PASSWORD=compassio_pg_dev
JWT_SECRET=dev_jwt_secret_change_me
# SECRET_KEY 用于签发 JWT，必须 >= 32 字符的随机值，否则后端启动即失败。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：不要照抄本示例值，生产环境务必替换为真实随机值。
SECRET_KEY=replace_with_a_random_value_of_at_least_32_chars
BCRYPT_ROUNDS=10
# LLM 默认走 opencode-go 网关（需要 x-opencode-session 头，程序已内置处理）
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/inference/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
# 其他可选 provider 示例：
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxx
